    "$type": "dimension",
    "$description": "Corner radius. `md` is the control radius: inputs, buttons, list rows.",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 9,
        "unit": "px"
      }
    },
    "lg": {
